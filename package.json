{
  "name": "gitpanel",
  "private": true,
  "version": "0.4.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:bridge": "node devserver/server.mjs",
    "dev:all": "concurrently -k -n bridge,web -c cyan,green \"node devserver/server.mjs\" \"vite\"",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "rust:check": "node scripts/with-cargo-target.mjs cargo check --workspace",
    "rust:test": "node scripts/with-cargo-target.mjs cargo test -p git-core",
    "rust:probe": "node scripts/with-cargo-target.mjs cargo run -p perf-probe --",
    "rust:size": "powershell -ExecutionPolicy Bypass -File scripts/clean-target.ps1",
    "rust:clean": "powershell -ExecutionPolicy Bypass -File scripts/clean-target.ps1 -Clean",
    "desktop:dev": "node scripts/with-cargo-target.mjs tauri dev",
    "desktop:build": "node scripts/with-cargo-target.mjs tauri build",
    "desktop:exe": "node scripts/with-cargo-target.mjs tauri build --no-bundle"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "pinia": "^4.1.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vue-tsc": "^3.3.14"
  }
}
